---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="404 — Raz Cohen" description="Page not found.">
  <section class="not-found">
    <img src={`${base}images/404.jpg`} alt="Lost" class="not-found-image" />
    <div class="not-found-text">
      <h1 class="not-found-heading">Lost it. That's a 404.</h1>
      <p class="not-found-sub">
        <a href={base} class="not-found-link">Take me back to mainland.</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 80px 40px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .not-found-image {
    width: 45%;
    max-width: 560px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .not-found-heading {
    font-size: 62px;
    font-weight: 600;
    line-height: 82px;
    color: #353535;
    margin: 0 0 8px;
  }

  .not-found-sub {
    font-size: 24px;
    color: #888;
    margin: 0;
  }

  .not-found-link {
    color: #353535;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .not-found-link:hover {
    color: #FF8B6A;
  }

  @media (max-width: 768px) {
    .not-found {
      flex-direction: column;
      gap: 32px;
    }

    .not-found-image {
      width: 100%;
      max-width: 100%;
    }

    .not-found-heading {
      font-size: 36px;
      line-height: 48px;
    }
  }
</style>
