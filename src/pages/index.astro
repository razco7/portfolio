---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
projects.sort((a, b) => a.data.order - b.data.order);

const featuredProjects = projects.filter(p => p.data.order <= 5);
const moreProjects = projects.filter(p => p.data.order > 5);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout title="Raz Cohen — Product Designer & Design Leader" activePage="home" ogImage="images/OG.jpg">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-heading">
        Hi, <span class="raz-hover"><a href={`${base}about`} class="raz-link">I'm Raz</a><img class="raz-popover" src={`${base}images/Raz_in_a_circle.png`} alt="Raz Cohen" /></span>. Product design leader &amp; consultant to startups. Design lecturer at Shenkar. Previously director of product design at Fiverr.
      </h1>
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.map((project) => {
    const { title, tagline, type, role, client, company, bgColor, accentColor, darkTheme, coverImage, teaserImage, images, imageAlts, youtubeId, externalLink, externalLinkLabel, externalOnly, description } = project.data;
    const metaClass = darkTheme ? 'dark' : '';
    return (
      <section class="project-section" style={`background-color: ${bgColor}`}>
        <div class="project-container">
          <h2 class={`project-heading${darkTheme ? ' dark' : ''}`}>
            <a
              href={`${base}projects/${project.slug}`}
              class="project-title-link"
              style={`color: ${accentColor}`}
            >
              {title}
            </a>
            {' — '}{tagline}
          </h2>

          {youtubeId ? (
            <div class="youtube-embed">
              <iframe
                src={`https://www.youtube.com/embed/${youtubeId}?rel=0&controls=1&autoplay=1&mute=1&start=0`}
                allow="autoplay; encrypted-media"
                allowfullscreen
                title={title}
              />
            </div>
          ) : (teaserImage ?? coverImage) ? (
            <a href={`${base}projects/${project.slug}`} class="single-image-link">
              <img src={`${base}images/${teaserImage ?? coverImage}`} alt={title} class="single-image" loading="lazy" />
            </a>
          ) : images.length === 1 ? (
            <a href={`${base}projects/${project.slug}`} class="single-image-link">
              <img src={`${base}images/${images[0]}`} alt={title} class="single-image" loading="lazy" />
            </a>
          ) : (
            <div class="slider" data-slider>
              <div class="slider-slides">
                {images.map((img, i) => (
                  <div class="slider-slide">
                    <a href={`${base}projects/${project.slug}`} class="slider-image-link">
                      <img src={`${base}images/${img}`} alt={imageAlts[i] ?? title} loading="lazy" />
                    </a>
                  </div>
                ))}
              </div>
              <button class="slider-arrow slider-arrow-left" aria-label="Previous slide">‹</button>
              <button class="slider-arrow slider-arrow-right" aria-label="Next slide">›</button>
              <div class="slider-dots">
                {images.map((_, i) => (
                  <button
                    class={`slider-dot${i === 0 ? ' active' : ''}`}
                    aria-label={`Go to slide ${i + 1}`}
                  />
                ))}
              </div>
            </div>
          )}
        </div>

        <div class="project-info">
          <div class="project-info-grid">
            <div class="project-meta">
              {company && <p class={metaClass}>Company: {company}</p>}
              {client && <p class={metaClass}>Client: {client}</p>}
              {type && <p class={metaClass}>Industry: {type}</p>}
              <p class={metaClass}>Role: {role}</p>
              {externalLink && (
                <p class={metaClass}>
                  <a href={externalLink} target="_blank" rel="noopener">
                    {externalLinkLabel ?? 'View'}
                  </a>
                </p>
              )}
            </div>
            <div class="project-desc">
              <p class={metaClass}>{description}</p>
            </div>
            {!externalOnly && (
              <p class={`project-case-link ${metaClass}`}>
                <a href={`${base}projects/${project.slug}`}>
                  Read case study
                </a>
              </p>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <!-- More Projects -->
  <section class="more-projects-section">
    <div class="more-projects-inner">
      <h2 class="more-projects-heading">More projects</h2>
      <div class="more-projects-grid">
        {moreProjects.map((project) => {
          const { title, tagline, bgColor, accentColor, darkTheme, coverImage, teaserImage, youtubeId, externalOnly, externalLink, externalLinkLabel, imagePosition } = project.data;
          const img = teaserImage ?? coverImage;
          const thumbSrc = img ? `${base}images/${img}` : youtubeId ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg` : null;
          const caseStudyHref = !externalOnly ? `${base}projects/${project.slug}` : null;
          return (
            <div class={`more-card${darkTheme ? ' dark' : ''}`} style={`background-color: ${bgColor}`}>
              {thumbSrc && (
                <a href={caseStudyHref ?? externalLink ?? '#'} target={externalOnly ? '_blank' : undefined} rel={externalOnly ? 'noopener' : undefined} class="more-card-image-link">
                  <img src={thumbSrc} alt={title} class="more-card-image" loading="lazy" style={imagePosition ? `object-position: ${imagePosition}` : undefined} />
                </a>
              )}
              <div class="more-card-info">
                <span class="more-card-title" style={`color: ${accentColor}`}>{title}</span>
                <span class={`more-card-tagline${darkTheme ? ' dark' : ''}`}>{tagline}</span>
                <div class="more-card-links">
                  {caseStudyHref ? (
                    <a href={caseStudyHref} class={`more-card-action${darkTheme ? ' dark' : ''}`}>
                      <span class="more-card-action-text">Read case study</span> <span class="material-symbols-outlined">arrow_forward</span>
                    </a>
                  ) : externalLink ? (
                    <a href={externalLink} target="_blank" rel="noopener" class={`more-card-action${darkTheme ? ' dark' : ''}`}>
                      <span class="more-card-action-text">{externalLinkLabel ?? 'View'}</span> <span class="material-symbols-outlined">arrow_outward</span>
                    </a>
                  ) : null}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ── Raz photo parallax ──
  const razHover = document.querySelector<HTMLElement>('.raz-hover');
  const razPopover = document.querySelector<HTMLElement>('.raz-popover');
  if (razHover && razPopover) {
    razHover.addEventListener('mousemove', (e) => {
      const rect = razHover.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / rect.width;
      const dy = (e.clientY - cy) / rect.height;
      razPopover.style.setProperty('--raz-x', `${dx * 10}px`);
      razPopover.style.setProperty('--raz-y', `${dy * 6}px`);
    });
    razHover.addEventListener('mouseleave', () => {
      razPopover.style.setProperty('--raz-x', '0px');
      razPopover.style.setProperty('--raz-y', '0px');
    });
  }

document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('.slider-slides')!;
    const dots = slider.querySelectorAll<HTMLElement>('.slider-dot');
    const total = slider.querySelectorAll('.slider-slide').length;
    let current = 0;

    const goTo = (n: number) => {
      dots[current]?.classList.remove('active');
      current = ((n % total) + total) % total;
      dots[current]?.classList.add('active');
      track.style.transform = `translateX(-${current * slider.offsetWidth}px)`;
    };

    slider.querySelector('.slider-arrow-left')?.addEventListener('click', () => goTo(current - 1));
    slider.querySelector('.slider-arrow-right')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    window.addEventListener('resize', () => {
      track.style.transition = 'none';
      track.style.transform = `translateX(-${current * slider.offsetWidth}px)`;
      requestAnimationFrame(() => { track.style.transition = ''; });
    }, { passive: true });
  });
</script>
