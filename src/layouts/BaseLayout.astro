---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: 'home' | 'about' | 'mixtapes';
  ogImage?: string;
}

const {
  title = 'Raz Cohen',
  description = 'Product designer and consultant working with startups, teaching at Shenkar. Previously director of product design at Fiverr.',
  activePage = 'home',
  ogImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = 'https://razco7.github.io';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const defaultOgImage = `${siteUrl}${base}images/Raz_in_a_circle.png`;
const ogImageUrl = ogImage ? `${siteUrl}${base}${ogImage}` : defaultOgImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:site_name" content="Raz Cohen" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,100..700,0,0"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav" id="main-nav">
      <div class="nav-inner">
        <a href={base} class="nav-brand">Raz Cohen</a>
        <div class="nav-links">
          <a href={`${base}mixtapes`} class={`nav-about${activePage === 'mixtapes' ? ' active' : ''}`}>Mixtapes</a>
          <a href={`${base}about`} class={`nav-about${activePage === 'about' ? ' active' : ''}`}>About</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <button class="back-to-top" id="back-to-top" aria-label="Back to top">
      <span class="material-symbols-outlined">arrow_upward</span>
    </button>

    <footer class="footer">
      <div class="footer-inner">
        <span class="footer-copyright">© 2026 Raz Cohen. All rights reserved</span>
        <div class="footer-social">
          <a href="https://www.linkedin.com/in/raz-cohen-381b9230/" target="_blank" rel="noopener">Linkedin</a>
          <a href="https://dribbble.com/razco7" target="_blank" rel="noopener">Dribbble</a>
          <a href="https://medium.com/@razco7" target="_blank" rel="noopener">Medium</a>
          <a href="https://www.behance.net/razco7" target="_blank" rel="noopener">Behance</a>
        </div>
      </div>
    </footer>

    <script>
      const nav = document.getElementById('main-nav');
      const backToTop = document.getElementById('back-to-top');
      const onScroll = () => {
        const scrolled = window.scrollY > 60;
        nav?.classList.toggle('scrolled', scrolled);
        const pct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        backToTop?.classList.toggle('visible', pct >= 0.2);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      onScroll();
    </script>
  </body>
</html>
